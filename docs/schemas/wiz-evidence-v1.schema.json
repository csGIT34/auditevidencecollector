{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Wiz evidence contract, project-defined v1",
  "$comment": "The Python validator additionally enforces ARM identity/scope, canonical UUIDs, time order, unique IDs and referential integrity. This is not a native Wiz API schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source",
    "resources",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "wiz_evidence"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "mode",
        "export_id",
        "exported_at",
        "tenant_id",
        "mapping_version",
        "scope",
        "inventory_complete",
        "findings_complete"
      ],
      "properties": {
        "system": {
          "const": "wiz"
        },
        "mode": {
          "enum": [
            "synthetic",
            "operator_export"
          ]
        },
        "export_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "mapping_version": {
          "const": "1.0"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscription_ids",
            "resource_group"
          ],
          "properties": {
            "subscription_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true
            },
            "resource_group": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "inventory_complete": {
          "type": "boolean"
        },
        "findings_complete": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wiz_id",
          "resource_id",
          "observed_at"
        ],
        "properties": {
          "wiz_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "resource_id": {
            "type": "string",
            "maxLength": 2048
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "resource_id",
          "rule_id",
          "severity",
          "status",
          "observed_at"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "resource_id": {
            "type": "string",
            "maxLength": 2048
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFORMATIONAL",
              "UNKNOWN"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "RESOLVED",
              "REJECTED",
              "UNKNOWN"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          }
        }
      }
    }
  }
}
